# Server Environment Variables
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL / Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Note: Active game state & real-time actions are managed authoritatively
# by the Node.js game server in-memory & Socket.IO.
# Supabase PostgreSQL is used for users, rooms, player membership,
# game records, results, statistics, and persistent match history.
