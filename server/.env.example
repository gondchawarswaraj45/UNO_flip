# Server Environment Variables
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# ==============================================================================
# PostgreSQL / Supabase Configuration
# ==============================================================================
# Direct PostgreSQL connection URI from Supabase:
# Project Settings -> Database -> Connection string (URI mode)
# Example (Direct connection on port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler (port 6543, recommended for serverless or IPv4 networks):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase API Credentials (Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
# Note: Keep the service-role key strictly on the backend server. NEVER expose it to the React client!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Note:
# Active real-time gameplay & card turns are authoritative in Node.js server memory and Socket.IO.
# Supabase PostgreSQL stores persistent users, rooms, membership logs, game records, results,
# statistics, and the global leaderboard.
